{
  "name": "siki-manual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev manual --host 127.0.0.1",
    "docs:build": "vitepress build manual",
    "docs:preview": "vitepress preview manual --host 127.0.0.1",
    "docs:check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run docs:check && npm test && npm run docs:build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "markdown-it": "14.1.0",
    "minisearch": "7.2.0",
    "vitepress": "1.6.4"
  }
}
